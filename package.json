{
  "name": "qaletx-link",
  "version": "0.3.0",
  "private": true,
  "description": "A simple Hysteria2 desktop client with qaletx link account management.",
  "main": "electron/main.cjs",
  "author": "qaletx link",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "node scripts/prepare-private-node.cjs && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "server": "node server.js",
    "dist:win": "npm run build && electron-builder --win portable nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never"
  },
  "build": {
    "appId": "com.qaletx.link",
    "productName": "qaletx link",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "core", "to": "core" },
      { "from": "assets/qaletx-link.png", "to": "assets/qaletx-link.png" },
      { "from": "assets/qaletx-link.ico", "to": "assets/qaletx-link.ico" }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "qaletx-link-${version}-${arch}.${ext}",
      "icon": "assets/qaletx-link.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "qaletx-link-${version}-${arch}.${ext}",
      "icon": "assets/qaletx-link.png"
    },
    "dmg": {
      "window": {
        "width": 520,
        "height": 340
      }
    },
    "icon": "assets/qaletx-link.png"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "^22.3.27",
    "electron-builder": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}

