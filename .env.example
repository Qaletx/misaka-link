# 上传时重命名为 .env，与 server.js 放同一目录；无需 npm install。
# 直接连接可用 0.0.0.0；同机 Nginx 反向代理可改为 127.0.0.1。
MISAKA_HOST=0.0.0.0
MISAKA_PORT=8787
# 至少 32 字符；可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成。
MISAKA_TOKEN_SECRET=请替换为至少32字符的随机密钥
# 下面两项只用于首次创建账号；已有账号的密码请在客户端修改。
MISAKA_USER_PASSWORD=请替换为user密码
MISAKA_ROOT_PASSWORD=请替换为root密码
# Electron 打包页面通过 file:// 加载，Origin 是 null，不能填 API 服务器域名。
# 如需同时允许网页开发，填写 null,http://127.0.0.1:5173；多个来源用逗号分隔。
MISAKA_CORS_ORIGIN=null
# 默认不信任 X-Forwarded-For。仅当同机 Nginx 代理且 8787 不对外开放时填写：127.0.0.1,::1
MISAKA_TRUSTED_PROXIES=
