# 上传时重命名为 .env，与 server.js 放同一目录；无需 npm install。
# 直接连接可用 0.0.0.0；同机 Nginx 反向代理可改为 127.0.0.1。
MISAKA_HOST=0.0.0.0
MISAKA_PORT=8787
# 至少 32 字符；可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成。
MISAKA_TOKEN_SECRET=请替换为至少32字符的随机密钥
# 下面两项只用于首次创建账号；已有账号的密码请在客户端修改。
MISAKA_USER_PASSWORD=请替换为user密码
MISAKA_ROOT_PASSWORD=请替换为root密码
# Electron 打包页面通过 file:// 加载，Origin 是 null，不能填 API 服务器域名。
# 如需同时允许网页开发，填写 null,http://127.0.0.1:5173；多个来源用逗号分隔。
MISAKA_CORS_ORIGIN=null
# 默认不信任 X-Forwarded-For。仅当同机 Nginx 代理且 8787 不对外开放时填写：127.0.0.1,::1
MISAKA_TRUSTED_PROXIES=

# 登录审计默认自动开启，无需添加这些配置也可使用；详细说明见 server/LOGIN-LOGS.md。
# 每天按北京时间保存 JSONL，默认保留 30 天；每天最多 3 个文件，每个 5 MiB。
MISAKA_LOGIN_LOG_RETENTION_DAYS=30
MISAKA_LOGIN_LOG_MAX_MB=5
MISAKA_LOGIN_LOG_FILES_PER_DAY=3

# Optional managed Hysteria2 services. Empty keeps existing deployment working.
# Local Traffic Stats API only; secret must match Hysteria2 trafficStats.secret.
# Example: [{"id":"primary","statsUrl":"http://127.0.0.1:9999","secret":"replace-with-random-secret-at-least-16-characters"}]
MISAKA_HY2_SERVICES=[]
MISAKA_HY2_AUTH_PORT=8788
MISAKA_HY2_POLL_MS=5000

# 首次创建数据库或迁移旧 users.json 时，预置为 ID=misaka 的私有线路。
# 可留空，之后 root 在「我的线路」添加。已有 data/state.json 时此配置不再覆盖线路。
# 填完整节点分享链接并加双引号；真实凭据不要提交到公开仓库。
MISAKA_PRIVATE_NODE_URI=
